#include <winresrc.h>

#define IDI_WHACKED_ICON 101

IDI_WHACKED_ICON ICON "../assets/whacked.ico"

VS_VERSION_INFO VERSIONINFO
 FILEVERSION     1,0,2,0
 PRODUCTVERSION  1,0,2,0
 FILEFLAGSMASK   0x3fL
 FILEFLAGS       0x0L
 FILEOS          VOS__WINDOWS32
 FILETYPE        VFT_APP
 FILESUBTYPE     0x0L
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName",      "WhackedRecomp Contributors"
            VALUE "FileDescription",  "Whacked! (Original Xbox) Static Recompilation"
            VALUE "FileVersion",      "1.0.2.0"
            VALUE "InternalName",     "WhackedRecomp"
            VALUE "LegalCopyright",   "MIT License (Clean-room runtime; Bring Your Own Game)"
            VALUE "OriginalFilename", "WhackedRecomp.exe"
            VALUE "ProductName",      "WhackedRecomp"
            VALUE "ProductVersion",   "1.0.2"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
